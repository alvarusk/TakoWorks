#!/bin/sh
# Bump version automatically before commit:
#  - main  -> +0.1.0 (minor, patch reset)
#  - others -> +0.0.1 (patch)
# Skips if SKIP_VERSION_BUMP is set.

ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
INIT_FILE="$ROOT/src/takoworks/__init__.py"

if [ -n "$SKIP_VERSION_BUMP" ]; then
  exit 0
fi

# If __init__ is already staged, assume the bump was already done.
if git diff --cached --name-only | grep -q "src/takoworks/__init__.py"; then
  exit 0
fi

PYTHON_BIN="${PYTHON_BIN:-}"
PYTHON_ARGS=""
if [ -z "$PYTHON_BIN" ] && command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif [ -z "$PYTHON_BIN" ] && command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif [ -z "$PYTHON_BIN" ] && command -v py >/dev/null 2>&1; then
  PYTHON_BIN="py"
  PYTHON_ARGS="-3"
elif [ -z "$PYTHON_BIN" ] && [ -x "/c/Users/ajime/AppData/Local/Programs/Python/Python313/python.exe" ]; then
  PYTHON_BIN="/c/Users/ajime/AppData/Local/Programs/Python/Python313/python.exe"
fi

if [ -z "$PYTHON_BIN" ]; then
  echo "pre-commit: no Python interpreter found. Set PYTHON_BIN or install Python in PATH." >&2
  exit 1
fi

if [ -n "$PYTHON_ARGS" ]; then
  "$PYTHON_BIN" $PYTHON_ARGS "$ROOT/bin/bump_version.py" --mode auto || exit 1
else
  "$PYTHON_BIN" "$ROOT/bin/bump_version.py" --mode auto || exit 1
fi

# Add version bump changes to the commit
git add "$INIT_FILE"
if [ -f "$ROOT/README.md" ]; then
  git add "$ROOT/README.md"
fi
